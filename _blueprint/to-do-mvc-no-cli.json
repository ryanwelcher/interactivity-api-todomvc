{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.0",
		"wp": "latest"
	},
	"features": {},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/ryanwelcher/interactivity-api-todomvc/archive/refs/heads/trunk.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/plugins/mvc-setup/"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/mvc-setup/mvc-setup.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/ryanwelcher/interactivity-api-todomvc/trunk/_blueprint/setup.php"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "/wordpress/wp-content/plugins/mvc-setup/"
		}
	]
}
